# --- Coucou dark UI (Louis-CFM/coucou, windows/src/style.css) ---
background-color=#141518
text-color=#f5f6f8
border-color=#4b5563
border-size=1
# Mako draws its own corners; match Hyprland decoration.rounding = 0.
border-radius=0
padding=14
margin=10
width=340
height=110
font=JetBrainsMono Nerd Font 11

# --- Icons ---
icons=1
max-icon-size=16
icon-location=left
# Set this to your system's icon theme to fix missing icons
icon-path=/usr/share/icons/Papirus:/usr/share/icons/Adwaita:/usr/share/icons/hicolor

markup=1

# --- Actions & Sound ---
# 3. Play a sound when a notification arrives
on-notify=exec paplay /usr/share/sounds/freedesktop/stereo/window-attention.oga

# Keep native actions and their Wayland activation token. The workspace
# helper observes ActionInvoked and focuses a reliably identified source.
on-button-left=invoke-default-action
on-button-right=dismiss

# 5. History limit (for restoring missed notifications)
max-history=50

# --- Auto-disappear ---
default-timeout=10000
ignore-timeout=0

# --- Layout ---
anchor=top-right
sort=-time
layer=overlay

# --- Urgency-based overrides ---
[urgency=low]
border-color=#4b5563
default-timeout=6000

[urgency=normal]
border-color=#f5a524
default-timeout=8000

[urgency=critical]
background-color=#141518
border-color=#f4505e
text-color=#ff8d97
default-timeout=0

# notify-send and other senders without actions still get click-to-focus.
[!actionable]
on-button-left=exec "$HOME/.local/bin/notification-workspaces" focus "$id"
