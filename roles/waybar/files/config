{
    // Orchestre waybar — top bar
    "layer": "top",
    "position": "top",
    "height": 22,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces"],
    "modules-right": ["pulseaudio", "network", "bluetooth", "group/temps", "custom/power-profile", "custom/fan-mode", "battery", "clock", "custom/power"],

    // Dynamic workspace dots; clicking focuses the workspace.
    // The button gets the .urgent class (blinking via style.css) when a
    // window in that workspace demands attention (e.g. new page opened
    // in a background browser tab).
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "default": "●",
            "active": "●",
            "urgent": "●"
        },
        "tooltips": {
            "default": "Workspace {name}\n{windows}",
            "empty": "Workspace {name}"
        },
        // Unknown window classes fall back to showing their class name
        // (e.g. "Alacritty") instead of waybar's default "?" placeholder.
        "window-rewrite-default": "{class}",
        "window-rewrite": {
            "class<firefox>": "󰈹",
            "class<[Zz]en.*>": "󰈹",
            "class<Chromium|chrome>": "󰊯",
            "class<code-oss|Code|VSCodium|Zed>": "󰨞",
            "class<okular>": "󰈙",
            "class<ristretto>": "󰋩",
            "class<Thunar>": "󰉋"
        },
        "on-click": "activate",
        "on-click-middle": "close",
        "sort-by": "id"
    },

    // Left-click: floating mixer (pavucontrol, floated by a Hyprland rule).
    // Right-click: mute toggle. Scroll: volume up/down.
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "max-volume": 100,
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "tooltip-format": "{desc}\nVolume: {volume}%"
    },

    // Left-click: Wi-Fi menu (enable/disable, disconnect, switch known network)
    "network": {
        "interval": 5,
        "format-wifi": "{icon} {essid}",
        // Signal-strength icons, low -> high (fair, good, very good, excellent)
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "format-ethernet": "󰈀 wired",
        "format-linked": "󰈀 linked",
        "format-disconnected": "󰤭 offline",
        "format-disabled": "󰤮 wifi off",
        "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}% ({signaldBm} dBm)\nIP: {ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "tooltip-format-disabled": "Wi-Fi is disabled",
        "on-click": "waybar-wifi-menu"
    },

    // CPU + GPU temps in a single pill (see #temps in style.css), separated
    // by a vertical line. Hover each side for its since-boot stats.
    "group/temps": {
        "orientation": "inherit",
        "modules": ["custom/cpu", "custom/gpu"]
    },

    // Temperatures via waybar-temp script (plain temperature, no icon).
    // CPU: coretemp/k10temp hwmon. GPU: NVIDIA when awake, else Intel SoC.
    // Hover shows min/avg/max since boot (state in ~/.cache/waybar-temp).
    "custom/cpu": {
        "exec": "waybar-temp cpu",
        "return-type": "json",
        "interval": 3
    },

    "custom/gpu": {
        "exec": "waybar-temp gpu",
        "return-type": "json",
        "interval": 3
    },

    // Bluetooth pill: blue when on (cyan when connected), grey when off.
    // Left-click toggles the adapter power (state persists across suspend and
    // reboots via the bluetooth-power-state units); right-click opens bluetui
    // in a floating terminal (see Hyprland rule).
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂱",
        "format-no-controller": "",
        "tooltip-format-on": "Bluetooth on — no devices connected\nLeft-click to turn off · Right-click for bluetui",
        "tooltip-format-off": "Bluetooth off\nLeft-click to turn on · Right-click for bluetui",
        "tooltip-format-disabled": "Bluetooth disabled",
        "tooltip-format-connected": "Bluetooth: {num_connections} connected\nLeft-click to turn off · Right-click for bluetui",
        "tooltip-format-enumerate-connected": " {device_alias}",
        "on-click": "sh -c 'bluetoothctl show 2>/dev/null | grep -q \"Powered: yes\" && exec bluetoothctl power off || exec bluetoothctl power on'",
        "on-click-right": "alacritty --class bluetui -e bluetui",
        "justify": "center",
        "max-length": 8
    },

    // Power profile pill, rendered by waybar-power-profile (a custom module:
    // waybar's power-profiles-daemon module ignores on-click handlers).
    // Left click cycles power-saver -> balanced -> performance, right click
    // cycles in reverse; the MSI EC shift/fan/boost modes stay in sync.
    // The fan pill beside it is pulled tight (style.css) so the pair reads
    // as one block, but each stays its own clickable module.
    "custom/power-profile": {
        "exec": "waybar-power-profile",
        "return-type": "json",
        "interval": 2,
        "signal": 8,
        "on-click": "waybar-power-profile set next",
        "on-click-right": "waybar-power-profile set prev",
        "justify": "center"
    },

    // Fan pill, rendered by waybar-fan-mode: cycles the MSI EC fan mode
    // (silent -> auto -> cooler_boost) independently of the power profile.
    // The braille spinner's speed encodes the state and style.css colors
    // the module per state, so the mode is visible at a glance.
    "custom/fan-mode": {
        "exec": "waybar-fan-mode",
        "return-type": "json",
        "interval": 0.2,
        "signal": 7,
        "on-click": "waybar-fan-mode set next",
        "on-click-right": "waybar-fan-mode set prev",
        "justify": "center"
    },

    // Battery at the left of the clock: icon follows the charge level
    // (10% steps), charging variant while plugged. Hidden automatically
    // on desktops with no battery. Low battery turns amber/red (style.css).
    "battery": {
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        },
        "tooltip-format": "{timeTo}\nCapacity: {capacity}%\nPower: {power:.1f} W",
        "events": {
            "on-discharging-warning": "notify-send -u normal 'Low battery' 'Battery below 30%'",
            "on-discharging-critical": "notify-send -u critical 'Very low battery' 'Battery below 15%'",
            "on-charging-100": "notify-send -u normal 'Battery full' 'Plug can be removed'"
        }
    },

    // Click toggles between time and full date; hover shows month calendar
    "clock": {
        "interval": 60,
        "format": "  {:%I:%M %p}",
        "format-alt": "󰃰  {:%A, %d %B %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "first-day-of-week": 1,
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#8cd8de'><b>{}</b></span>",
                "weekdays": "<span color='#9a9aa5'><b>{}</b></span>",
                "weeks":    "<span color='#6c6c78'><b>W{}</b></span>",
                "days":     "<span color='#e8e8ec'>{}</span>",
                "today":    "<span color='#8cd8de'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down",
            "on-click-right": "mode"
        }
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "waybar-power-menu",
        "tooltip": false,
        "justify": "center"
    }
}
