{
    "label": "lock",
    "action": "hyprlock -c $HOME/.config/hypr/hyprlock/hyprlock.conf",
    "text": "Lock [L]",
    "keybind": "l"
}
{
    "label": "suspend",
    "action": "systemctl suspend",
    "text": "Suspend [S]",
    "keybind": "s"
}
{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "Reboot [R]",
    "keybind": "r"
}
{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "Power Off [P]",
    "keybind": "p"
}
