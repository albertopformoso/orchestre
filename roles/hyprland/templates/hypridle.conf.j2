general {
    # What command to run when the system asks to lock (e.g., loginctl lock-session)
    lock_cmd = pidof hyprlock || hyprlock -c $HOME/.config/hypr/hyprlock/hyprlock.conf
    
    # Lock the screen before the system goes to sleep
    before_sleep_cmd = pidof hyprlock || hyprlock -c $HOME/.config/hypr/hyprlock/hyprlock.conf
    
    # Turn on the display and restore the power profile immediately after waking up
    # (ppd-idle.sh restore no-ops unless a profile was saved by an idle timeout)
    after_sleep_cmd = hyprctl dispatch 'hl.dsp.dpms({ action = "on" })'; ~/.local/bin/ppd-idle.sh restore
}

# 1. DIM SCREEN (e.g., after 2.5 minutes)
listener {
    timeout = 150
    # '-s' saves the current brightness, then sets it to 1%
    on-timeout = brightnessctl -s set 1%
    # '-r' restores the brightness to the saved value
    on-resume = brightnessctl -r
}

# 2. LOCK SCREEN (e.g., after 5 minutes)
listener {
    timeout = 300
    on-timeout = pidof hyprlock || hyprlock -c $HOME/.config/hypr/hyprlock/hyprlock.conf
}

# 3. TURN OFF SCREEN (e.g., after 6.5 minutes)
listener {
    timeout = 390
    on-timeout = hyprctl dispatch 'hl.dsp.dpms({ action = "off" })'
    on-resume = hyprctl dispatch 'hl.dsp.dpms({ action = "on" })'
}

# 3.5 POWER PROFILE — 30s after the screen turns off, drop to power-saver.
# On resume (input or wake from sleep), restore the user's original profile.
listener {
    timeout = 570
    on-timeout = ~/.local/bin/ppd-idle.sh save
    on-resume = ~/.local/bin/ppd-idle.sh restore
}

# 4. SUSPEND after 1.5h of idle
listener {
    timeout = 5400
    on-timeout = systemctl suspend
}

{% if is_msi_device %}
# 5. KEYBOARD
listener {
    timeout = 20
    on-timeout = ~/.local/bin/kbdlight off
    on-resume = ~/.local/bin/kbdlight restore
}
{% endif %}
