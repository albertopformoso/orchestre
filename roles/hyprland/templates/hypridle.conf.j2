general {
    # What command to run when the system asks to lock (e.g., loginctl lock-session)
    lock_cmd = pidof hyprlock || hyprlock -c $HOME/.config/hypr/hyprlock/hyprlock.conf
    
    # Lock the screen before the system goes to sleep
    before_sleep_cmd = pidof hyprlock || hyprlock -c $HOME/.config/hypr/hyprlock/hyprlock.conf
    
    # Turn on the display immediately after waking up
    after_sleep_cmd = hyprctl dispatch 'hl.dsp.dpms({ action = "on" })' 
}

# 1. DIM SCREEN (e.g., after 2.5 minutes)
listener {
    timeout = 150
    # '-s' saves the current brightness, then sets it to 1%
    on-timeout = brightnessctl -s set 1%
    # '-r' restores the brightness to the saved value
    on-resume = brightnessctl -r
}

# 2. LOCK SCREEN (e.g., after 5 minutes)
listener {
    timeout = 300
    on-timeout = pidof hyprlock || hyprlock -c $HOME/.config/hypr/hyprlock/hyprlock.conf
}

# 3. TURN OFF SCREEN (e.g., after 6.5 minutes)
listener {
    timeout = 390
    # Switch to power-saver while the display is off
    on-timeout = hyprctl dispatch 'hl.dsp.dpms({ action = "off" })' && ~/.local/bin/ppd-idle.sh save
    # Restore the previous power profile as soon as input is detected
    on-resume = ~/.local/bin/ppd-idle.sh restore && hyprctl dispatch 'hl.dsp.dpms({ action = "on" })'
}

# 4. SLEEP (e.g., after 1.5 hours of idle)
listener {
    timeout = 5400
    # Plain suspend: hibernation unavailable (not enough swap for a RAM image).
    # Locking is handled by before_sleep_cmd on the systemd prepare-for-sleep event.
    on-timeout = ~/.local/bin/ppd-idle.sh restore && systemctl suspend
}

{% if is_msi_device %}
# 5. KEYBOARD
listener {
    timeout = 20
    on-timeout = ~/.local/bin/kbdlight off
    on-resume = ~/.local/bin/kbdlight restore
}
{% endif %}
